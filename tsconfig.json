{  
  "compilerOptions": {  
    "target": "ES2019",  
    "module": "commonjs",  
    "moduleResolution": "node",  
    "outDir": "lib",  
    "declaration": true,  
    "declarationMap": true,  
    "declarationDir": "typings",  
    "sourceMap": true,  
    "strict": true,  
    "esModuleInterop": true,  
    "resolveJsonModule": true,  
    "skipLibCheck": true,  
    "forceConsistentCasingInFileNames": true  
  },  
  "include": ["src/**/*.ts"]  
}
